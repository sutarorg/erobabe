# ============================================================
# EroBabe — environment template. Copy to .env and fill in.
# NEVER commit real values. Server-only secrets must NOT use
# the VITE_ prefix (those are inlined into the public bundle).
# ============================================================

# ---- public site / client ----
VITE_DEMO_MODE=true                    # false → use the real API below
VITE_API_BASE_URL=/api
VITE_DEMO_ADMIN_USER=admin             # demo-mode login only
VITE_DEMO_ADMIN_PASSWORD=erobabe-demo  # demo-mode login only

# ---- deployment ----
PUBLIC_SITE_URL=https://erobabe.com    # used for CORS + secure cookies

# ---- Supabase (server-side access) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=                     # public anon key (read published only)
SUPABASE_SERVICE_ROLE_KEY=             # SECRET — server-only, never in browser

# ---- Cloudflare R2 (object storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=erobabe
R2_PUBLIC_BASE_URL=https://cdn.erobabe.com   # public delivery hostname

# ---- admin auth ----
ADMIN_USERNAME=
# scrypt hash format: scrypt:N:salt_hex:hash_hex  (see README § Admin password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=                        # 32+ random bytes, e.g. `openssl rand -hex 32`

# ---- video processing (optional until configured) ----
PROCESSING_PROVIDER=                   # "ffmpeg-worker" when ready
PROCESSING_PROVIDER_URL=               # your FFmpeg worker base URL
PROCESSING_PROVIDER_API_KEY=

# ---- limits ----
MAX_UPLOAD_BYTES=2147483648            # 2 GB
