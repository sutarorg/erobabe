# ─────────────────────────────────────────────────────────────
# EroBabe environment template — copy to `.env` for local work and
# mirror every value into your Vercel/Netlify project settings.
# NEVER commit a filled-in .env. NEVER put these in frontend code.
# ─────────────────────────────────────────────────────────────

# ── Admin authentication ──
# Generate with:  node scripts/hash-password.mjs "your-strong-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_SCRYPT="16384$8$1$BASE64_SALT$BASE64_HASH"
# Random 48+ char secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# ── Supabase (Postgres + PostgREST) ──
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Server-side only — never expose in the browser bundle
SUPABASE_SERVICE_ROLE_KEY=""

# ── Cloudflare R2 (S3-compatible object storage) ──
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-api-token-access-key-id"
R2_SECRET_ACCESS_KEY="r2-api-token-secret-access-key"
R2_BUCKET="erobabe-media"
# Public base URL serving the bucket (custom domain or https://pub-xxx.r2.dev)
R2_PUBLIC_BASE_URL="https://media.your-domain.com"

# ── Video processing ──
# original   → mark uploaded files ready as-is (single-file MP4/WebM playback)
# callback   → keep videos in "processing" until an external worker calls
#              POST /api/admin/process/callback with renditions/HLS
PROCESSING_MODE="original"
# Shared secret for the processing webhook (required in callback mode)
PROCESSING_WEBHOOK_SECRET=""

# Public site URL (used for absolute links, sitemaps)
SITE_URL="https://erobabe.com"
