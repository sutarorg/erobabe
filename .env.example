# Erobabe Environment Variables — Example (no secrets)
# Copy to .env.local and fill with real values

# Site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://erobabe.com

# Supabase — obtain from Supabase Dashboard > Project Settings > API
# Publishable key is safe for browser, secret key is server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alternative name for service role (legacy)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NOWPayments — https://nowpayments.io — docs: https://nowpayments.io/api
# API key from the NOWPayments dashboard (Store Settings > API Keys).
# Server-only: never a NEXT_PUBLIC_* variable.
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
# IPN Secret Key from the NOWPayments dashboard (Store Settings > IPN Secret
# Key). Used to verify the x-nowpayments-sig header on every IPN.
# Server-only. Without it every incoming IPN is rejected.
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
# Optional setup-diagnostic default (checkout uses explicit asset/network). One of:
# usdterc20, usdttrc20, usdtbsc, usdtsol, btc, eth, trx, bnbbsc, sol.
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdterc20
# Optional. Pins the exact IPN callback URL the app sends to NOWPayments with
# every payment and reports in Admin > System Health. Must be an absolute URL
# ending in /api/nowpayments/ipn; anything else is ignored (with a warning in
# System Health) and the URL is derived from NEXT_PUBLIC_SITE_URL.
# See DEPLOYMENT.md section C.
# NOWPAYMENTS_IPN_CALLBACK_URL=https://your-approved-domain/api/nowpayments/ipn

# Bunny Stream — server-only; selected Video Library > API (NOT account API key).
# See DEPLOYMENT.md section D. Never use NEXT_PUBLIC_* for these values.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# OpenRouter — https://openrouter.ai/keys (AI video metadata only; comment usernames use the local word library)
# Server-only: never a NEXT_PUBLIC_* variable. Keys start with "sk-or-".
# Generated titles are 6-16 words in the site's publishing voice (see
# VIDEO_TITLE_STYLE below); descriptions are validated at 20-25 words.
# Verify the key from Admin > System Health > "Test OpenRouter".
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# Voice for generated listing titles. Default: explicit — blunt adult copy that
# names the act ("My Girlfriend Grabs My Cock For An Intense Raw Doggy Style Fuck
# In Our Apartment"). Set to "editorial" to keep the older euphemistic magazine
# voice for generated copy.
# Both voices keep the same non-negotiable floor: no age-ambiguous wording, no
# family-role framing, nothing implying a partner who cannot consent.
# VIDEO_TITLE_STYLE=explicit
# Optional. Model slug. Default: deepseek/deepseek-v3.2
# OPENROUTER_MODEL=deepseek/deepseek-v3.2
# Optional. Output-token budget for one metadata suggestion. Default: 2048.
# Raise it if suggestions are still truncated.
# OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Optional actual-frame vision ranking. DISABLED by default. Local scoring always works.
# Enable BOTH flags only after confirming model/provider adult-content and data policy.
OPENROUTER_THUMBNAIL_ENABLED=false
OPENROUTER_THUMBNAIL_CONTENT_APPROVED=false
# No default model: choose a model whose live catalogue lists image input.
# OPENROUTER_THUMBNAIL_MODEL=operator_verified_image_model_slug
# Pin the specifically approved OpenRouter provider slug (no fallback routing).
# OPENROUTER_THUMBNAIL_PROVIDER=operator_approved_provider_slug

# Optional. Path to an ffmpeg binary used for existing manual direct-media frame thumbnails. Leave
# unset to use the bundled @ffmpeg-installer/ffmpeg binary (linux-x64).
# Requires Node.js hosting with executable support and outbound HTTP(S) to media.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Resend Email — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@erobabe.com
SUPPORT_EMAIL=support@erobabe.com

# Supabase Storage buckets (create via dashboard or migration)
# ad-creatives bucket for advertiser creatives
# video-thumbnails bucket for video thumbs

# Optional operator upload budget in bytes. Enforced at session reservation and
# browser validation; also configure Bunny account-side limits for actual bytes.
# BUNNY_UPLOAD_MAX_BYTES=10737418240

# Recommended dedicated server-only random secret for daily rotating analytics
# pseudonyms/rate keys. If absent, the server Supabase secret key is used.
# Configure ingress to OVERWRITE x-real-ip; do not trust a client-supplied value.
# ANALYTICS_HASH_SECRET=
