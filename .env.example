# Erobabe Environment Variables — Example (no secrets)
# Copy to .env.local and fill with real values

# Site URL (canonical)
SITE_URL=https://erobabe.com
NEXT_PUBLIC_SITE_URL=https://erobabe.com

# Supabase — obtain from Supabase Dashboard > Project Settings > API
# Publishable key is safe for browser, secret key is server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alternative name for service role (legacy)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NOWPayments — https://nowpayments.io — docs: https://nowpayments.io/api
# API key from the NOWPayments dashboard (Store Settings > API Keys).
# Server-only: never a NEXT_PUBLIC_* variable.
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
# IPN Secret Key from the NOWPayments dashboard (Store Settings > IPN Secret
# Key). Used to verify the x-nowpayments-sig header on every IPN.
# Server-only. Without it every incoming IPN is rejected.
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
# Optional default asset identifier, e.g. usdterc20. Must be one of:
# usdterc20, usdttrc20, usdtbsc, usdtsol, btc, eth, trx, bnbbsc, sol.
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdterc20
# Optional. Pins the exact IPN callback URL the app sends to NOWPayments with
# every payment and reports in Admin > System Health. Must be an absolute URL
# ending in /api/nowpayments/ipn; anything else is ignored (with a warning in
# System Health) and the URL is derived from NEXT_PUBLIC_SITE_URL.
# See DEPLOYMENT.md section C.
NOWPAYMENTS_IPN_CALLBACK_URL=https://erobabe.vercel.app/api/nowpayments/ipn

# Video Hosting — Streamtape (https://streamtape.com/api)
# Video bytes travel browser → streaming relay → Streamtape upload node. They
# never pass through a Next.js/Vercel function (request-body limit 4.5 MB) and
# never touch Supabase Storage. See DEPLOYMENT.md section D for the relay.
#
# API Login + API Key: Streamtape User Panel → Account Settings → API/FTP
# credentials. Server-only: never a NEXT_PUBLIC_* variable, never returned to
# the browser, never logged (the app redacts them from errors and audit rows).
# Rotate by generating new credentials in the panel and updating these two
# hosting secrets, then redeploy.
STREAMTAPE_LOGIN=your_streamtape_api_login
STREAMTAPE_API_KEY=your_streamtape_api_key
# Optional. Folder id new uploads go into (Streamtape file manager → folder id).
STREAMTAPE_FOLDER_ID=
#
# Fail-closed content-policy gate. Leave "false" — every upload is refused with a
# clear configuration error — until YOU have verified that Streamtape's terms
# (https://streamtape.com/terms-and-conditions), copyright policy and the
# account's content settings permit this catalog, and that you hold the rights
# and consent for what you publish. Streamtape's terms contain no explicit
# clause either permitting or banning lawful adult content.
STREAMTAPE_ADULT_CONTENT_ALLOWED=false
#
# Streaming relay (relay/streamtape-relay.mjs) — a separate always-on Node >= 18
# service/container, NOT Next.js/Vercel. Deploy it first, then set its real public
# HTTPS origin below (example.com is deliberately not accepted by the app).
# Generate one random secret (e.g. `openssl rand -hex 32`) and set the exact same
# value in the app and relay service. Do not use a sample or placeholder string.
STREAMTAPE_RELAY_URL=
STREAMTAPE_RELAY_SECRET=
# Relay-side only (set in the relay service, not the app):
#   STREAMTAPE_RELAY_ALLOWED_ORIGINS=https://erobabe.vercel.app
#   RELAY_PORT=8787  (optional; otherwise the host's PORT is used)
#   RELAY_MAX_UPLOAD_BYTES=16106127360
# Optional. Largest upload this deployment accepts, in bytes. Streamtape does not
# state a per-file limit in its API docs (a 2021 community README claims 15 GB):
# set this to the limit you verified in your account.
# STREAMTAPE_MAX_UPLOAD_BYTES=16106127360
# Optional. Extra upload-node host suffixes to trust if Streamtape moves its
# nodes (default: tapecontent.net, streamtape.com).
# STREAMTAPE_UPLOAD_HOST_SUFFIXES=
# Optional. Safety cap on links per "Upload by link" batch (default 10).
# STREAMTAPE_MAX_ACTIVE_IMPORTS=10
#
# Which hosting integration new uploads use. Only "streamtape" (real uploads)
# and "internal" (no hosting — embeds only) are accepted; anything else —
# including the retired "ufoload" — fails closed. Existing UFOLOAD/Uqload videos
# keep playing from their stored embed URLs.
VIDEO_PROVIDER=streamtape

# Live tests only (never set in production hosting) — see tests/live/README.md:
# LIVE_STREAMTAPE=1
# LIVE_E2E_STREAMTAPE=1 PLAYWRIGHT_BASE_URL=https://staging.example.com E2E_ADMIN_EMAIL=... E2E_ADMIN_PASSWORD=...

# Gemini API — https://aistudio.google.com/apikey
# Server-only: never a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest
# Optional. Output-token budget for one metadata suggestion. Thinking tokens are
# counted against it, so keep it well above the ~150 tokens the JSON needs.
# Default: 2048. Raise it if suggestions are still truncated.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Optional. Set to "off" to send no thinkingConfig at all (for models that
# reject thinkingBudget). Default: 0 — thinking off, so the whole budget goes
# to the JSON payload.
GEMINI_THINKING_BUDGET=0

# Resend Email — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@erobabe.com
SUPPORT_EMAIL=support@erobabe.com

# Supabase Storage buckets (create via dashboard or migration)
# ad-creatives bucket for advertiser creatives
# video-thumbnails bucket for video thumbs
# videos bucket for internal provider

# Optional: Sentry, Analytics, etc.
# NEXT_PUBLIC_POSTHOG_KEY=
