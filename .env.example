# Erobabe Environment Variables — Example (no secrets)
# Copy to .env.local and fill with real values

# Site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://erobabe.com

# Supabase — obtain from Supabase Dashboard > Project Settings > API
# Publishable key is safe for browser, secret key is server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alternative name for service role (legacy)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Advertising checkout hands the advertiser to the hosted PayPal payment page
# (lib/ads/payment.ts) after saving the order. Its fixed right-hand panel shows
# public/checkout/advertise-panel.webp (960 x 1080, exact 8:9) - a committed
# asset, so there is no image-host or artwork variable to configure.
# There are no PayPal API credentials or webhook secrets: staff manually verify
# each payment in PayPal from Admin > Ad Review before making an ad live.
# The old NOWPayments checkout, IPN, status, and reconciliation APIs are retired.

# Video catalog — embeds from damplips.com.
# Uploads are retired: there is no upload page, no encoding queue and no cron
# sweep, and no video bytes ever pass through this app.
#
# Fill the catalog once with:  npm run import:damplips -- --categories=all --per-category=110
# Or use Videos → "Sync from damplips" in the admin dashboard. The importer
# stores title, poster, duration, source page and the media destination each
# damplips post serves. A direct host file plays straight from that host; the
# /api/videos/stream proxy is the fallback and the only path for HLS.
#
# Optional: point the importer at a mirror or a staging copy of the site.
# DAMPLIPS_BASE_URL=https://www.damplips.com
#
# Optional: signing key for the stream proxy. An HLS playlist names its segments
# and keys, and damplips often serves those from a media CDN rather than from
# damplips.com. Those URIs are proxied with a short-lived signature so playback
# works without turning /api/videos/stream into an open proxy. Use any long
# random string; when unset the Supabase secret key is used.
# MEDIA_PROXY_SECRET=change-me-to-a-long-random-string
#
# Optional: how long the stream proxy waits for the media host to answer before
# it gives up (milliseconds, default 12000). Only the response headers are on
# this clock — a long file still streams for as long as it needs.
# MEDIA_UPSTREAM_TIMEOUT_MS=12000
#
# The importer marks what it writes as rights-cleared so imported videos are
# publicly visible. Run with `--rights=pending` (or Rights = pending in the
# dashboard) to stage imports as private drafts instead. Keep the DMCA and
# content-removal pages current — they are the takedown path for embedded
# third-party content.

# OpenRouter — https://openrouter.ai/keys (AI video metadata only; comment usernames use the local word library)
# Server-only: never a NEXT_PUBLIC_* variable. This must be a real OpenRouter key
# starting with "sk-or-"; the model ID belongs in OPENROUTER_MODEL below.
# Generated titles are 6-16 words in the site's publishing voice (see
# VIDEO_TITLE_STYLE below); descriptions are validated at 20-25 words.
# Verify the key from Admin > System Health > "Test OpenRouter".
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# Voice for generated listing titles. Default: explicit — blunt adult copy that
# names the act ("My Girlfriend Grabs My Cock For An Intense Raw Doggy Style Fuck
# In Our Apartment"). Set to "editorial" to keep the older euphemistic magazine
# voice for generated copy.
# Both voices keep the same non-negotiable floor: no age-ambiguous wording, no
# family-role framing, nothing implying a partner who cannot consent.
# VIDEO_TITLE_STYLE=explicit
# Optional. Model slug. Default is the free OpenRouter route:
# nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional. Comma- or space-separated routes tried, in order, when the model
# above stops answering: a free endpoint can sit in the provider's queue longer
# than a draft may wait, and without a fallback the request waits on it forever
# ("Waiting for AI title: openRouter did not answer in time").
# Unset uses the built-in free NVIDIA fallbacks:
#   nvidia/nemotron-3.5-lightning:free, nvidia/nemotron-3-super-120b-a12b:free
# Set it empty (OPENROUTER_FALLBACK_MODELS=) to ask the preferred model only.
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free, nvidia/nemotron-3-super-120b-a12b:free
# Optional. First-attempt output-token cap for one metadata suggestion. Default: 512.
# Empty/truncated replies may retry with a larger cap; semantic retries stay at 512.
# OPENROUTER_MAX_OUTPUT_TOKENS=512

# Resend Email — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@erobabe.com
SUPPORT_EMAIL=support@erobabe.com

# Supabase Storage buckets (create via dashboard or migration)
# ad-creatives bucket for advertiser creatives
# video-thumbnails bucket for category artwork thumbnails

# Recommended dedicated server-only random secret for daily rotating analytics
# pseudonyms/rate keys. If absent, the server Supabase secret key is used.
# Configure ingress to OVERWRITE x-real-ip; do not trust a client-supplied value.
# ANALYTICS_HASH_SECRET=
