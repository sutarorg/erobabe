# Erobabe Environment Variables — Example (no secrets)
# Copy to .env.local and fill with real values

# Site URL (canonical)
SITE_URL=https://erobabe.com
NEXT_PUBLIC_SITE_URL=https://erobabe.com

# Supabase — obtain from Supabase Dashboard > Project Settings > API
# Publishable key is safe for browser, secret key is server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alternative name for service role (legacy)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bcon Global — https://bcon.global
# Create a store per chain, then copy that store's generated API key.
# Configure the callback URL in the Bcon dashboard as a RAW string per chain
# (no Markdown, object, array, or quotes in the dashboard field).
BCON_API_KEY=your_bcon_api_key_per_chain
BCON_CALLBACK_URL=https://your-domain.example/api/bcon/callback
BCON_CHAIN=ethereum
BCON_PAYMENT_CURRENCY=USDT

# Video Hosting — Uqload (blocked for adult content without approval)
# Local video files POST directly from the admin browser to Uqload's upload server.
# The key is returned only to authenticated admins as a form field for that request.
# Obtain from https://uqload.vc > Account Settings > API key.
# IMPORTANT: Uqload TOS may prohibit pornography/nudity. Do NOT enable for adult content without written approval.
# Set UQLOAD_ADULT_CONTENT_APPROVED=true only after obtaining written confirmation that lawful adult content, commercial use, API upload and intended playback are permitted.
VIDEO_PROVIDER=uqload
UQLOAD_API_KEY=your_uqload_api_key
UQLOAD_ADULT_CONTENT_APPROVED=false

# Groq AI — https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Resend Email — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@erobabe.com
SUPPORT_EMAIL=support@erobabe.com

# Supabase Storage buckets (create via dashboard or migration)
# ad-creatives bucket for advertiser creatives
# video-thumbnails bucket for video thumbs
# videos bucket for internal provider

# Optional: Sentry, Analytics, etc.
# NEXT_PUBLIC_POSTHOG_KEY=
